@startuml domain-model
hide methods
hide circle

class Customer {
  name
  email
}

class DeliveryAddress {
  district
  street
}

class Restaurant {
  id
  name
  cuisine
  district
  deliveryFee
  minimumBasket
}

class MenuItem {
  id
  name
  category
  price
}

class Cart {
  subtotal
  deliveryFee
  total
}

class CartLine {
  quantity
  lineTotal
}

class Order {
  number
  status
  subtotal
  deliveryFee
  total
}

class OrderLine {
  itemId
  itemName
  unitPrice
  quantity
  lineTotal
}

Customer "1" --> "1" DeliveryAddress : has
Customer "1" --> "0..1" Cart : fills
Cart "1" *-- "0..*" CartLine : contains
CartLine "*" --> "1" MenuItem : refers to
Cart "*" --> "0..1" Restaurant : is for
Restaurant "1" *-- "1..*" MenuItem : offers
Customer "1" --> "0..*" Order : places
Order "*" --> "1" Restaurant : ordered from
Order "1" *-- "1..*" OrderLine : consists of
Order "*" --> "1" DeliveryAddress : delivered to
@enduml
