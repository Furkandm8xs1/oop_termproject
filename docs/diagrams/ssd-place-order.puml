@startuml ssd-place-order
skinparam style strictuml
actor Customer
participant ":FoodFlow System" as S

Customer -> S : register(name, email, district, street)
S --> Customer : customer confirmation & delivery address

Customer -> S : listRestaurants(cuisine, district)
S --> Customer : matching restaurants

Customer -> S : viewMenu(restaurantId)
S --> Customer : restaurant menu grouped by category

loop for each desired item
    Customer -> S : addItem(itemId, quantity)
    S --> Customer : item added, updated cart summary
end

Customer -> S : viewCart()
S --> Customer : cart summary (lines, subtotal, deliveryFee, total)

Customer -> S : placeOrder()
S --> Customer : order confirmation (number, status PLACED) & receipt
@enduml
